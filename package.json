{
  "name": "maglody",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prepare-offline.mjs",
    "preview": "vite preview",
    "server": "node server/index.ts",
    "dev:mobile": "HTTPS=1 vite --host",
    "selftest": "node scripts/mobile-selftest.cjs",
    "test:e2e": "playwright test",
    "test:ui": "playwright test -c playwright.a.config.ts",
    "test:webaudio": "node scripts/webaudio-check.mjs",
    "test:deploy": "node scripts/deploy-smoke.mjs",
    "test:logic": "node scripts/audio-regression.cjs && node scripts/logic-regression.cjs",
    "selftest:unit": "node --import ./scripts/test-loader.mjs --test --test-isolation=none scripts/tests/*.test.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.0"
  }
}
