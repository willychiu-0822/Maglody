{
  "name": "maglody",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prepare-offline.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "node server/index.ts",
    "dev:mobile": "HTTPS=1 vite --host",
    "selftest": "node scripts/mobile-selftest.cjs",
    "test:e2e": "playwright test",
    "test:ui": "playwright test -c playwright.a.config.ts",
    "test:webaudio": "node scripts/webaudio-check.mjs",
    "test:deploy": "node scripts/deploy-smoke.mjs",
    "test:logic": "node scripts/audio-regression.cjs && node scripts/logic-regression.cjs",
    "selftest:unit": "node --import ./scripts/test-loader.mjs --test scripts/tests/*.test.mjs",
    "test": "npm run typecheck && npm run lint && npm run selftest:unit && npm run test:logic && npm run build && npm run test:deploy",
    "test:all": "npm test && npm run test:webaudio"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.1.0"
  }
}
